# Dependencies and build artefacts are always rebuilt inside the image
**/node_modules
**/dist
**/.next
**/.turbo

# Version control and editors
.git
.github
.husky
.vscode
.idea

# Local runtime data must never leak into the image
uploads/
database/
logs/
docker/uploads/
docker/database/
docker/logs/
**/*.sqlite
**/*.sqlite-journal
minio/
insomnia.json

# Local environment files
.env
**/.env
**/.env.local

# Documentation and planning notes (not needed to build)
plans/
docs/
*.md
