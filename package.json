{
	"name": "safestorage",
	"version": "1.0.0",
	"description": "Blazing fast file uploader and bunker written in node! 🚀",
	"private": true,
	"scripts": {
		"build": "turbo run build",
		"dev": "turbo run dev",
		"lint": "turbo run lint",
		"format": "turbo run format",
		"generate": "yarn workspace @safestorage/backend generate",
		"migrate": "yarn workspace @safestorage/backend migrate",
		"start": "yarn workspace @safestorage/backend start",
		"dev:backend": "yarn workspace @safestorage/backend dev",
		"dev:frontend": "yarn workspace @safestorage/next dev",
		"start:backend": "yarn workspace @safestorage/backend start",
		"start:frontend": "yarn workspace @safestorage/next start",
		"update": "yarn upgrade-interactive"
	},
	"author": "Ivan Carlos",
	"license": "MIT",
	"engines": {
		"node": ">=22.19.0"
	},
	"packageManager": "yarn@4.1.1",
	"workspaces": [
		"packages/backend",
		"packages/next",
		"packages/uploader-client",
		"packages/uploader-module"
	],
	"resolutions": {
		"@react-stately/flags": "3.0.5",
		"node-gyp": "^11.4.2",
		"tar": "7.5.22",
		"minimatch@9.0.3": "9.0.9",
		"deepmerge-ts": "8.0.2",
		"ajv@^6.12.4": "6.14.0",
		"ajv@~6.12.6": "6.14.0",
		"browserslist": "4.29.3",
		"cross-spawn@^6.0.0": "6.0.6",
		"cross-spawn@^7.0.1": "7.0.6",
		"cross-spawn@^7.0.2": "7.0.6",
		"esbuild@^0.27.0": "0.28.2",
		"fast-uri@^3.0.1": "3.1.9",
		"fast-uri@^3.0.5": "3.1.9",
		"fast-uri@^4.0.0": "4.2.3",
		"glob@10.3.10": "10.5.0",
		"glob@^10.2.2": "10.5.0",
		"glob@^10.3.10": "10.5.0",
		"glob@^10.3.7": "10.5.0",
		"mysql2": "3.24.4",
		"nanoid@^3.3.7": "3.3.20",
		"postcss": "8.5.30",
		"postcss-selector-parser": "7.1.6",
		"yaml": "2.9.1"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.5",
		"eslint": "^9.39.5",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-import-x": "^4.17.1",
		"eslint-plugin-n": "^18.4.1",
		"eslint-plugin-promise": "^7.3.0",
		"eslint-plugin-react": "^7.37.5",
		"eslint-plugin-react-hooks": "^7.1.1",
		"eslint-plugin-unicorn": "^65.0.1",
		"globals": "^17.13.0",
		"turbo": "^2.11.7",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.71.2"
	}
}
