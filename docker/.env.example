# Copy this file to `.env` and adjust the values, then run:
#   docker compose pull && docker compose up -d

# Host port the application is published on (port 80 inside the container).
SAFESTORAGE_PORT=24424

# Image tag to run: `latest` or a pinned release such as `1.1.0`.
SAFESTORAGE_TAG=latest

# Password of the automatically created `admin` user. It is only used the very
# first time the container starts, when no database exists yet.
ADMIN_PASSWORD=please-change-me

# Timezone used by the container log timestamps.
TZ=UTC
