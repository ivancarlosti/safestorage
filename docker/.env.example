# Copy this file to `.env` and adjust the values, then run:
#   docker compose pull && docker compose up -d

# Host port the application is published on (port 80 inside the container).
SAFESTORAGE_PORT=24424

# Image tag to run: `latest` or a pinned release such as `1.1.0`.
SAFESTORAGE_TAG=latest

# --- Authentication -----------------------------------------------------------
#
# How users sign in: `account` (the email + password form, the default) or
# `keycloak` (hand the login over to an OIDC provider). Only one is active at a
# time; anything else falls back to `account`. See docs/configuration.md for the
# full contract. Only the variables that are uncommented reach the container:
# an empty value is treated as "not configured".

# AUTH_METHOD=account

# --- Local accounts (AUTH_METHOD=account) -------------------------------------
#
# Comma-separated emails and their positionally matched passwords. The first
# email becomes the `owner` of the instance, the others regular users. A bcrypt
# hash (`$2a$...`) works as a password too, so the plaintext never has to live
# here. An email without a password gets a random one and cannot use the form.
# ACCOUNT_LOGIN=owner@example.com,someone@example.com
# ACCOUNT_PASSWORD=please-change-me,another-please-change-me

# Legacy single-user setup: password of the `admin` user. It is only used the
# very first time the container starts, while the database is still empty, and
# only when `ACCOUNT_LOGIN` is unset. Use `ACCOUNT_LOGIN` on a new install.
ADMIN_PASSWORD=please-change-me

# --- Keycloak / OIDC (AUTH_METHOD=keycloak) -----------------------------------
#
# The first five variables are all required by `AUTH_METHOD=keycloak`.
# `KEYCLOAK_REDIRECT_URI` has to match the *Valid redirect URI* of the client
# and `KEYCLOAK_RESTRICT` (whole emails or bare domains) limits who may sign in:
# the boot refuses to start without it, unless `ACCOUNT_LOGIN` already declares
# the allowed accounts. Omit the client secret for a public client with PKCE.
# KEYCLOAK_BASE_URL=https://sso.example.com
# KEYCLOAK_REALM=safestorage
# KEYCLOAK_CLIENT_ID=safestorage
# KEYCLOAK_CLIENT_SECRET=please-change-me
# KEYCLOAK_REDIRECT_URI=https://safestorage.example.com/api/auth/keycloak/callback
# KEYCLOAK_RESTRICT=example.com

# --- reCAPTCHA on the login form ----------------------------------------------
#
# reCAPTCHA v2 checkbox. Set both values to enable it: the site key is handed to
# the browser, the secret stays on the server. While the pair is incomplete the
# login form stays exactly as it is.
# RECAPTCHA_CLIENTID=6Lc...
# RECAPTCHA_CLIENTSECRET=6Lc...

# Timezone used by the container log timestamps.
TZ=UTC

# --- Database -----------------------------------------------------------------
#
# MariaDB/MySQL connection string used by the backend and by the database
# migrations. SafeStorage does not ship a database of its own: create one (or a
# user + schema) on any MariaDB 10.5+/MySQL 8 server and point this at it.
#
# `host.docker.internal` reaches the Docker host, which is where a database you
# installed on the machine normally listens; docker-compose.yml maps that name to
# the host gateway on Linux. Use the service name instead when the database runs
# in another compose project on the same network.
DATABASE_URL=mysql://safestorage:please-change-me@host.docker.internal:3306/safestorage

# Optional: throwaway database only used by `prisma migrate dev` on a developer
# machine (never by `prisma migrate deploy`). Only set it when your database user
# cannot create the shadow database automatically.
# SHADOW_DATABASE_URL=mysql://safestorage:please-change-me@host.docker.internal:3306/safestorage_shadow

# --- Bundled database (docker-compose-bundle.yml only) ------------------------
#
# `docker-compose-bundle.yml` runs the official MariaDB image next to
# SafeStorage and already defines the values below with these same defaults, so
# nothing has to be set here. Uncomment them to change the bundled credentials;
# compose reads them from this file automatically. `DATABASE_URL` above is
# ignored by that file, because it assembles its own string pointing at the
# `mariadb` service.
# MARIADB_ROOT_PASSWORD=safestorage-root
# MARIADB_DATABASE=safestorage
# MARIADB_USER=safestorage
# MARIADB_PASSWORD=safestorage
