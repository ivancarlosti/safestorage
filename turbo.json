{
	"$schema": "https://turbo.build/schema.json",
	"globalDependencies": ["yarn.lock", "**/tsconfig.json", "eslint.config.mjs"],
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"inputs": ["src/**/*.ts"],
			"outputs": ["dist/**", "lib/**"]
		},
		"dev": {
			"dependsOn": ["^build"],
			"cache": false,
			"persistent": true
		},
		"lint": {
			"inputs": ["src/**/*.{ts,tsx}", "**/eslint.config.mjs", "**/.prettierignore", "**/.prettierrc.json"]
		},
		"format": {
			"inputs": ["src/**/*.{ts,tsx}", "**/eslint.config.mjs", "**/.prettierignore", "**/.prettierrc.json"]
		}
	}
}
