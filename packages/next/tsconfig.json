{
	"extends": "../../tsconfig.json",
	"compilerOptions": {
		// Next.js
		"jsx": "preserve",
		"baseUrl": ".",
		// This app never emits declarations, so opt out of declaration emit /
		// portability analysis inherited from the root tsconfig. TypeScript 5.9
		// reports TS2742 ("inferred type cannot be named ... not portable") for
		// re-exported third-party component types, which is only relevant when
		// emitting `.d.ts` files.
		"declaration": false,
		"declarationMap": false,
		"noEmit": true,
		"allowJs": true,
		"incremental": true,
		"skipLibCheck": true,
		"plugins": [
			{
				"name": "next"
			}
		],
		"paths": {
			"@/*": ["./src/*"]
		},
		"lib": ["dom", "dom.iterable", "esnext"],
		"strict": true,
		"forceConsistentCasingInFileNames": true,
		"esModuleInterop": true,
		"module": "esnext",
		"moduleResolution": "node",
		"resolveJsonModule": true,
		"isolatedModules": true,
		"strictNullChecks": true
	},
	"include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
	"exclude": ["node_modules"]
}
