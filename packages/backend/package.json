{
	"name": "@safestorage/backend",
	"version": "0.0.0",
	"description": "Blazing fast file uploader and bunker written in node! 🚀",
	"license": "MIT",
	"author": "Ivan Carlos",
	"scripts": {
		"build": "rimraf dist && tsc && node scripts/rewrite-path-aliases.mjs",
		"start": "yarn migrate && cross-env NODE_ENV=production NODE_PRESERVE_SYMLINKS=1 node -r dotenv/config dist/main.js dotenv_config_path=../../.env",
		"dev": "cross-env NODE_PRESERVE_SYMLINKS=1 tsx watch src/main.ts",
		"studio": "prisma studio",
		"generate": "prisma generate",
		"migrate": "prisma migrate deploy && prisma generate",
		"migrate:dev": "prisma migrate dev && prisma generate",
		"setup": "yarn install && yarn migrate",
		"lint": "prettier --check . && cross-env TIMING=1 eslint src",
		"format": "prettier --write . && cross-env TIMING=1 eslint src --fix"
	},
	"type": "module",
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1150.0",
		"@aws-sdk/s3-request-presigner": "^3.1150.0",
		"@fastify/cookie": "^11.1.3",
		"@fastify/cors": "^11.3.1",
		"@fastify/helmet": "^13.1.2",
		"@fastify/rate-limit": "^11.2.1",
		"@fastify/sensible": "^6.0.7",
		"@fastify/static": "^10.1.6",
		"@fastify/swagger": "^9.9.2",
		"@napi-rs/blake-hash": "^1.4.0",
		"@prisma/adapter-mariadb": "7.10.1",
		"@prisma/client": "7.10.1",
		"@safestorage/uploader-module": "workspace:*",
		"@scalar/fastify-api-reference": "^1.76.0",
		"@sindresorhus/slugify": "^3.0.1",
		"adm-zip": "^0.6.1",
		"bcryptjs": "^3.0.3",
		"chokidar": "^5.0.0",
		"cross-env": "^10.1.0",
		"dotenv": "^18.0.7",
		"envinfo": "^7.21.0",
		"fastify": "^5.12.6",
		"fastify-type-provider-zod": "^7.0.0",
		"file-stream-rotator": "^1.0.0",
		"file-type": "^22.1.1",
		"fluent-ffmpeg": "^2.1.3",
		"fs-jetpack": "^5.1.0",
		"jsonwebtoken": "^9.0.3",
		"lookpath": "^1.2.3",
		"node-schedule": "^2.1.1",
		"openapi-types": "^12.1.3",
		"pino": "^10.4.0",
		"pino-pretty": "^13.2.0",
		"randomstring": "^1.3.2",
		"shiki": "^4.5.0",
		"systeminformation": "^5.33.15",
		"unzipit": "^2.1.1",
		"uuid": "^14.0.3",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@types/envinfo": "^7.8.4",
		"@types/fluent-ffmpeg": "^2.1.28",
		"@types/jsonwebtoken": "^9.0.10",
		"@types/node": "^22.20.5",
		"@types/node-schedule": "^2.1.8",
		"@types/randomstring": "^1.3.0",
		"eslint": "^9.39.5",
		"prettier": "^3.9.10",
		"prisma": "7.10.1",
		"rimraf": "^6.1.3",
		"tsx": "^4.23.15",
		"typescript": "^5.9.3"
	},
	"keywords": [
		"safestorage",
		"upload",
		"uploader",
		"file",
		"ssr",
		"file uploader",
		"images"
	],
	"engines": {
		"node": ">=22.19.0"
	}
}
