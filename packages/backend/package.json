{
	"name": "@safestorage/backend",
	"version": "0.0.0",
	"description": "Blazing fast file uploader and bunker written in node! 🚀",
	"license": "MIT",
	"author": "Ivan Carlos",
	"scripts": {
		"build": "rimraf dist && tsc && tsc-alias",
		"start": "yarn migrate && cross-env NODE_ENV=production NODE_PRESERVE_SYMLINKS=1 node -r dotenv/config -r tsconfig-paths/register dist/main.js dotenv_config_path=../../.env",
		"dev": "cross-env NODE_PRESERVE_SYMLINKS=1 tsx watch src/main.ts",
		"studio": "prisma studio",
		"generate": "prisma generate",
		"migrate": "prisma migrate deploy && prisma generate",
		"migrate:dev": "prisma migrate dev && prisma generate",
		"setup": "yarn install && yarn migrate",
		"lint": "prettier --check . && cross-env TIMING=1 eslint src --ext .ts",
		"format": "prettier --write . && cross-env TIMING=1 eslint src --ext .ts --fix"
	},
	"type": "module",
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1150.0",
		"@aws-sdk/s3-request-presigner": "^3.1150.0",
		"@chibisafe/uploader-module": "1.0.12",
		"@fastify/cookie": "^11.1.3",
		"@fastify/cors": "^11.3.1",
		"@fastify/helmet": "^13.1.2",
		"@fastify/rate-limit": "^11.2.1",
		"@fastify/sensible": "^6.0.7",
		"@fastify/static": "^10.1.6",
		"@fastify/swagger": "^9.9.2",
		"@napi-rs/blake-hash": "^1.4.0",
		"@prisma/adapter-better-sqlite3": "7.10.0",
		"@prisma/client": "7.10.0",
		"@scalar/fastify-api-reference": "^1.74.0",
		"@sindresorhus/slugify": "^2.2.1",
		"adm-zip": "^0.6.1",
		"bcryptjs": "^2.4.3",
		"better-sqlite3": "^12.11.1",
		"chokidar": "^3.6.0",
		"cross-env": "^7.0.3",
		"dotenv": "^16.4.5",
		"envinfo": "^7.21.0",
		"fastify": "^5.12.5",
		"fastify-type-provider-zod": "^4.0.2",
		"ffmpeg-probe": "^1.0.6",
		"file-stream-rotator": "^1.0.0",
		"file-type": "^19.0.0",
		"fluent-ffmpeg": "^2.1.3",
		"fs-jetpack": "^5.1.0",
		"jsonwebtoken": "^9.0.3",
		"live-directory": "^3.0.3",
		"lookpath": "^1.2.3",
		"moment": "^2.31.0",
		"node-schedule": "^2.1.1",
		"pino": "^10.4.0",
		"pino-pretty": "^13.2.0",
		"proxy-addr": "^2.0.8",
		"randomstring": "^1.3.2",
		"shiki": "^1.3.0",
		"systeminformation": "^5.33.15",
		"tsc-alias": "^1.9.7",
		"tsconfig-paths": "^4.2.0",
		"unzipit": "^1.4.3",
		"uuid": "^9.0.1",
		"zod": "^3.25.76"
	},
	"devDependencies": {
		"@types/bcryptjs": "^2.4.6",
		"@types/cors": "^2.8.19",
		"@types/envinfo": "^7.8.4",
		"@types/fancy-log": "^2.0.2",
		"@types/fluent-ffmpeg": "^2.1.24",
		"@types/jsonwebtoken": "^9.0.10",
		"@types/node": "^22.20.5",
		"@types/node-schedule": "^2.1.8",
		"@types/proxy-addr": "^2.0.3",
		"@types/randomstring": "^1.3.0",
		"@types/sharp": "^0.32.0",
		"@types/uuid": "^9.0.8",
		"eslint": "^8.57.0",
		"eslint-config-neon": "^0.1.62",
		"prettier": "^3.9.10",
		"prisma": "7.10.0",
		"rimraf": "^5.0.5",
		"tsx": "^4.23.15",
		"typescript": "^5.4.4"
	},
	"keywords": [
		"safestorage",
		"upload",
		"uploader",
		"file",
		"ssr",
		"file uploader",
		"images"
	],
	"engines": {
		"node": ">=22.0.0"
	}
}
